{
  "_note": "behavior 경로분기 + origin group failover + Lambda@Edge 를 한 배포에 넣은 예. 실검증됨(config 수락 + Deployed). B1_DOMAIN/B2_DOMAIN/EDGE_ARN:VER 치환, _note 제거 후 create-distribution.",
  "CallerReference": "lab-cdn-1",
  "Comment": "lab-cdn",
  "Enabled": true,
  "DefaultRootObject": "index.html",
  "Origins": { "Quantity": 2, "Items": [
    { "Id": "pri", "DomainName": "B1_DOMAIN", "S3OriginConfig": { "OriginAccessIdentity": "" } },
    { "Id": "sec", "DomainName": "B2_DOMAIN", "S3OriginConfig": { "OriginAccessIdentity": "" } }
  ]},
  "OriginGroups": { "Quantity": 1, "Items": [
    { "Id": "og1", "FailoverCriteria": { "StatusCodes": { "Quantity": 2, "Items": [500, 502] } },
      "Members": { "Quantity": 2, "Items": [{ "OriginId": "pri" }, { "OriginId": "sec" }] } }
  ]},
  "DefaultCacheBehavior": {
    "TargetOriginId": "og1",
    "ViewerProtocolPolicy": "redirect-to-https",
    "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
    "LambdaFunctionAssociations": { "Quantity": 1, "Items": [
      { "EventType": "origin-response", "LambdaFunctionARN": "EDGE_ARN:VER", "IncludeBody": false }
    ]}
  },
  "CacheBehaviors": { "Quantity": 1, "Items": [
    { "PathPattern": "/api/*", "TargetOriginId": "pri", "ViewerProtocolPolicy": "https-only",
      "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad" }
  ]}
}
