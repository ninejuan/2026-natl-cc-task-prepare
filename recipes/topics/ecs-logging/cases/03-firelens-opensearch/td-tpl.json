{
  "family": "lab-oslog",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCTID:role/lab-oslog-exec",
  "taskRoleArn": "arn:aws:iam::ACCTID:role/lab-oslog-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "public.ecr.aws/docker/library/busybox:latest",
      "essential": true,
      "command": ["sh", "-c", "i=0; while true; do echo \"{\\\"level\\\":\\\"INFO\\\",\\\"seq\\\":$i,\\\"msg\\\":\\\"hello-opensearch\\\"}\"; i=$((i+1)); sleep 3; done"],
      "logConfiguration": {
        "logDriver": "awsfirelens",
        "options": {
          "Name": "opensearch",
          "Host": "OSHOST",
          "Port": "443",
          "Index": "ecs-logs",
          "AWS_Auth": "On",
          "AWS_Region": "ap-northeast-2",
          "tls": "On",
          "Suppress_Type_Name": "On",
          "Retry_Limit": "2"
        }
      }
    },
    {
      "name": "log-router",
      "image": "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable",
      "essential": true,
      "firelensConfiguration": { "type": "fluentbit", "options": { "enable-ecs-log-metadata": "true" } },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lab-firelens-router",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "router",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
